{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apiosk company-source research catalog",
  "type": "object",
  "required": [
    "schema_version",
    "as_of",
    "scope",
    "counts",
    "sources",
    "countries",
    "capability_contracts",
    "apiosk_integration"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "name",
          "publisher",
          "country_codes",
          "source_class",
          "access",
          "rights",
          "coverage",
          "required_work",
          "references",
          "readiness"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "country_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "required_work": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url",
                "evidence",
                "checked_at"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "readiness": {
            "type": "object",
            "required": [
              "apiosk",
              "activation_authorized_by_this_file"
            ],
            "properties": {
              "activation_authorized_by_this_file": {
                "const": false
              }
            }
          },
          "access": {
            "type": "object",
            "required": [
              "mode",
              "authentication",
              "upstream_cost",
              "apiosk_list_price_micro_usd"
            ],
            "properties": {
              "apiosk_list_price_micro_usd": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    "countries": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "required": [
          "country_code",
          "name",
          "native_source_ids",
          "region"
        ]
      }
    },
    "capability_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "spec_id",
          "source_id",
          "method",
          "path",
          "input_schema",
          "input_map",
          "upstream_output_map",
          "verification",
          "status"
        ],
        "properties": {
          "status": {
            "const": "draft_not_registered"
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "list_price_micro_usd": {
            "type": "null"
          }
        }
      }
    }
  }
}
