DATABASE_URL=postgresql://gateway_v2_server:replace-me@database-host:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
STATE_SIGNING_KEY=replace-with-at-least-32-random-bytes
INTENT_API_URL=https://openrouter.ai/api/v1/chat/completions
INTENT_API_KEY=
INTENT_MODEL=google/gemma-3-12b-it
# OpenRouter only: latency, throughput or price. Other compatible endpoints ignore this.
INTENT_PROVIDER_SORT=latency
# Optional; omission keeps INTENT_MODEL for analysis and default provider routing.
# ANALYSIS_MODEL=google/gemma-3-12b-it
# ANALYSIS_PROVIDER_SORT=throughput
# TypeSafe is opt-in. Shadow compares decisions but returns the existing path.
# On accepts bounded, verified decisions and falls back to INTENT_MODEL.
TYPESAFE_MODE=off
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Total deadline per TypeSafe stage, including selection and verification.
TYPESAFE_TIMEOUT_MS=2000
APP_ORIGIN=http://localhost:5276
BIND_ADDRESS=127.0.0.1:8082
RUST_LOG=apiosk_gateway_v2=info
# Enable only with the migrated state tables and deterministic v1 executor.
V2_EXECUTION_ENABLED=0
# Server-side upstream credential used by scripts/provision-overheid-io.mjs.
# Never expose this value to the App or commit it.
OVERHEID_IO_API_KEY=
