DATABASE_URL=postgresql://gateway_v2_server:replace-me@database-host:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
STATE_SIGNING_KEY=replace-with-at-least-32-random-bytes
INTENT_API_URL=https://openrouter.ai/api/v1/chat/completions
INTENT_API_KEY=
# Intent, planning and single-provider analysis use parser::MODEL;
# these variables only document it and any other value is ignored.
INTENT_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# Ask v2 is an independent capability-only parser, always through OpenRouter.
# It uses OPENROUTER_API_KEY, falling back to INTENT_API_KEY when absent.
# ASK_V2_MODEL documents the pinned ask_v2::DEFAULT_MODEL; overrides are ignored.
OPENROUTER_API_KEY=
ASK_V2_MODEL=openai/gpt-oss-120b
# OpenRouter only: latency, throughput or price. Other compatible endpoints ignore this.
INTENT_PROVIDER_SORT=latency
# Single-provider analysis uses the same pinned model. Multi-provider synthesis
# uses parser::MULTISOURCE_ANALYSIS_MODEL (GPT-6.1 Sol) with saved evidence only.
# It has no environment model override and cannot plan or purchase sources.
# ANALYSIS_PROVIDER_SORT=throughput
APP_ORIGIN=http://localhost:5276
BIND_ADDRESS=127.0.0.1:8082
RUST_LOG=apiosk_gateway_v2=info
# Enable only with the migrated state tables and deterministic v1 executor.
V2_EXECUTION_ENABLED=0
# Private recurring rollout; all three settings are required server-side.
# Empty/malformed owner lists deny every account. Never expose these via VITE_.
RECURRING_ORDERS_ENABLED=0
RECURRING_ALLOWED_OWNER_IDS=
RECURRING_WORKER_SECRET=
# Server-side upstream credential used by scripts/provision-overheid-io.mjs.
# Never expose this value to the App or commit it.
OVERHEID_IO_API_KEY=
# Bright Data LinkedIn scrapers: private executor credential. Provision with
# node scripts/provision-brightdata.mjs; never put it in catalog metadata.
BRIGHTDATA_API_KEY=
