# Use only when the gateway runtime sources and Cargo.lock match the running
# image. GATEWAY_BASE_IMAGE must be that image's immutable digest. This retains
# its gateway and operator tools while replacing only the embedded executor.
ARG GATEWAY_BASE_IMAGE
FROM rust:1.97.1-slim-bookworm AS executor-builder
WORKDIR /executor
COPY legacy-executor ./
RUN cargo build --locked --release --bin apiosk-gateway

FROM ${GATEWAY_BASE_IMAGE}
ARG GIT_SHA=unknown
ENV GATEWAY_GIT_SHA=$GIT_SHA
COPY --from=executor-builder /executor/target/release/apiosk-gateway /usr/local/bin/apiosk-payment-executor
