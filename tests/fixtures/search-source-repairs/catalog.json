      "slug": "web.stableenrich-search",
      "name": "Web search via StableEnrich",
      "description": "Web search via StableEnrich. Returns the requested page or bounded search response with original source URLs. No exhaustive coverage claim.",
      "input_contract": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "example": "Natalia Trushin-Jimenez law office Miami"
          },
          "category": {
            "type": "string",
            "example": "company"
          },
          "numResults": {
            "type": "integer",
            "example": 5
          },
          "excludeDomains": {
            "type": "array",
            "example": [
              "yelp.com",
              "google.com",
              "linkedin.com"
            ]
          }
        }
      },
      "output_contract": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "url"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      }
    },
    {
      "slug": "web.linkup-answer",
      "name": "Sourced web answer via Linkup",
      "description": "Sourced web answer via Linkup. Returns the requested page or bounded search response with original source URLs. No exhaustive coverage claim.",
      "input_contract": {
        "type": "object",
        "required": [
          "q",
          "depth",
          "outputType"
        ],
        "properties": {
          "q": {
            "type": "string",
            "example": "What is Microsoft's 2024 revenue?",
            "description": "The natural language question you want context for."
          },
          "depth": {
            "enum": [
              "fast",
              "standard"
            ],
            "type": "string",
            "default": "standard",
            "description": "fast is a sub-second mode for simple, focused queries; standard uses agentic search for broader questions. Linkup also has deep, but it charges five times as much for it as this listing sells, so it is not offered here."
          },
          "toDate": {
            "type": "string",
            "format": "date",
            "example": "2025-12-31",
            "description": "Only consider results published on or before this date (YYYY-MM-DD)."
          },
          "fromDate": {
            "type": "string",
            "format": "date",
            "example": "2025-01-01",
            "description": "Only consider results published on or after this date (YYYY-MM-DD)."
          },
          "maxResults": {
            "type": "number",
            "example": 5,
            "minimum": 1,
            "description": "Upper bound on the number of results."
          },
          "outputType": {
            "enum": [
              "searchResults",
              "sourcedAnswer",
              "structured"
            ],
            "type": "string",
            "description": "searchResults returns the sources and their text; sourcedAnswer returns a written answer plus its sources; structured returns JSON matching structuredOutputSchema."
          },
          "includeImages": {
            "type": "boolean",
            "default": false,
            "description": "Include image results."
          },
          "excludeDomains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "wikipedia.org"
            ],
            "description": "Drop results from these domains."
          },
          "includeDomains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "microsoft.com"
            ],
            "maxItems": 100,
            "description": "Search only these domains."
          },
          "includeSources": {
            "type": "boolean",
            "default": false,
            "description": "Only for structured: add the sources to the response. It changes the response shape."
          },
          "includeInlineCitations": {
            "type": "boolean",
            "default": false,
            "description": "Only for sourcedAnswer: put the citations inline in the answer."
          },
          "structuredOutputSchema": {
            "type": "string",
            "example": "{\"type\":\"object\",\"properties\":{\"revenue\":{\"type\":\"number\"}}}",
            "description": "Required when outputType is structured: a JSON schema, as a string, whose root is an object."
          }
        }
      },
      "output_contract": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "url"
              ]
            }
          }
        },
        "required": [
          "answer",
          "sources"
        ]
      }
    },
    {
      "slug": "web.linkup-fetch",
      "name": "Read a web page via Linkup",
      "description": "Read a web page via Linkup. Returns the requested page or bounded search response with original source URLs. No exhaustive coverage claim.",
      "input_contract": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://docs.linkup.so",
            "description": "The page to fetch."
          },
          "mode": {
            "enum": [
              "standard",
              "pro"
            ],
            "type": "string",
            "default": "standard",
            "description": "pro has a markedly higher success rate on pages that resist scraping. Same price."
          },
          "schema": {
            "type": "string",
            "example": "{\"type\":\"object\",\"properties\":{\"price\":{\"type\":\"number\"}}}",
            "description": "Optional JSON schema (root type object) describing structured data to extract from the page. Fields with no grounded value are left out."
          },
          "renderJs": {
            "type": "boolean",
            "default": false,
            "description": "Render the page's JavaScript before reading it."
          },
          "instructions": {
            "type": "string",
            "example": "Use public list prices only and express monetary values in USD.",
            "description": "Optional guidance for the extraction. Requires schema."
          },
          "extractImages": {
            "type": "boolean",
            "default": false,
            "description": "Also return the images found on the page."
          },
          "includeRawContent": {
            "type": "boolean",
            "default": false,
            "description": "Also return the raw page content and its content type."
          }
        }
      },
      "output_contract": {
        "type": "object",
        "properties": {
          "markdown": {
            "type": "string"
          }
        },
        "required": [
          "markdown"
        ]
      }
    }
