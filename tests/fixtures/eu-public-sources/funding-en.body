049\":[{\"plannedOpeningDate\":\"05 May 2020\",\"deadlineDates\":[\"01 September 2020\"],\"action\":\"LC-SC3-CC-1-2018-2019-2020 - RIA Research and Innovation action\",\"budgetYearMap\":{\"2020\":10000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300048\":[{\"plannedOpeningDate\":\"05 May 2020\",\"deadlineDates\":[\"01 September 2020\"],\"action\":\"LC-SC3-RES-20-2020 - IA Innovation action\",\"budgetYearMap\":{\"2020\":10000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300047\":[{\"plannedOpeningDate\":\"05 May 2020\",\"deadlineDates\":[\"01 September 2020\"],\"action\":\"LC-SC3-RES-34-2020 - IA Innovation action\",\"budgetYearMap\":{\"2020\":10000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300046\":[{\"plannedOpeningDate\":\"05 May 2020\",\"deadlineDates\":[\"01 September 2020\"],\"action\":\"LC-SC3-RES-36-2020 - RIA Research and Innovation action\",\"budgetYearMap\":{\"2020\":5000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300045\":[{\"plannedOpeningDate\":\"05 May 2020\",\"deadlineDates\":[\"01 September 2020\"],\"action\":\"LC-SC3-RES-25-2020 - RIA Research and Innovation action\",\"budgetYearMap\":{\"2020\":5000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300044\":[{\"plannedOpeningDate\":\"05 May 2020\",\"deadlineDates\":[\"01 September 2020\"],\"action\":\"LC-SC3-SCC-2-2020 - ERA-NET-Cofund ERA-NET Cofund\",\"budgetYearMap\":{\"2020\":5000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300165\":[{\"plannedOpeningDate\":\"26 September 2019\",\"deadlineDates\":[\"28 April 2020\"],\"action\":\"LC-SC3-RES-10-2020 - PCP Pre-Commercial Procurement\",\"budgetYearMap\":{\"2020\":15000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300043\":[{\"plannedOpeningDate\":\"05 May 2020\",\"deadlineDates\":[\"01 September 2020\"],\"action\":\"LC-SC3-NZE-6-2020 - RIA Research and Innovation action\",\"budgetYearMap\":{\"2020\":14000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300164\":[{\"plannedOpeningDate\":\"26 September 2019\",\"deadlineDates\":[\"28 April 2020\"],\"action\":\"LC-SC3-JA-5-2020 - RIA Research and Innovation action\",\"budgetYearMap\":{\"2020\":15000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300042\":[{\"plannedOpeningDate\":\"01 August 2018\",\"deadlineDates\":[\"16 October 2018\",\"25 April 2019\"],\"action\":\"LC-SC3-RES-14-2019 - RIA Research and Innovation action\",\"budgetYearMap\":{\"2019\":20000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"two-stage\"}],\"3300163\":[{\"plannedOpeningDate\":\"16 July 2019\",\"deadlineDates\":[\"15 January 2020\"],\"action\":\"LC-SC3-B4E-10-2020 - IA Innovation action\",\"budgetYearMap\":{\"2020\":6000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300041\":[{\"plannedOpeningDate\":\"01 August 2018\",\"deadlineDates\":[\"16 October 2018\",\"25 April 2019\"],\"action\":\"LC-SC3-RES-1-2019-2020 - RIA Research and Innovation action\",\"budgetYearMap\":{\"2019\":20000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"two-stage\"}],\"3300162\":[{\"plannedOpeningDate\":\"16 July 2019\",\"deadlineDates\":[\"15 January 2020\"],\"action\":\"LC-SC3-EC-4-2020 - RIA Research and Innovation action\",\"budgetYearMap\":{\"2020\":10000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300040\":[{\"plannedOpeningDate\":\"05 March 2020\",\"deadlineDates\":[\"10 September 2020\"],\"action\":\"LC-SC3-B4E-14-2020 - CSA Coordination and support action\",\"budgetYearMap\":{\"2020\":6000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"single-stage\"}],\"3300161\":[{\"plannedOpeningDate\":\"16 July 2019\",\"deadlineDates\":[\"15 January 2020\"],\"action\":\"LC-SC3-B4E-1-2020 - CSA Coordination and support action\",\"budgetYearMap\":{\"2020\":7000000},\"budgetTopicActionMap\":{},\"deadlineModel\":\"sin