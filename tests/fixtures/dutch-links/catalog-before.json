        },
        "sluitingsDatumVanaf": {
          "type": "string",
          "required": false,
          "description": "Only notices closing on or after this date, ISO yyyy-mm-dd \u2014 the filter for finding tenders still open to bid on. Note the capital D."
        },
        "publicatieDatumVanaf": {
          "type": "string",
          "required": false,
          "description": "Only notices published on or after this date, ISO yyyy-mm-dd."
        },
        "publicatieDatumPreset": {
          "enum": [
            "AF7",
            "AF30"
          ],
          "type": "string",
          "required": false,
