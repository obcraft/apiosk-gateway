    "vat.eu.validate.result": {
      "type": "object",
      "required": [
        "data",
        "source_url",
        "notice",
        "coverage"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "country_code",
            "vat_number",
            "valid",
            "request_date",
            "name",
            "address",
            "upstream"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "valid": {
              "type": "boolean",
              "$comment": "{\"apiosk_output_aliases_v1\":[\"is_valid\"]}"
            },
            "address": {
              "type": [
                "string",
                "null"
              ]
            },
            "upstream": {
              "type": "object"
            },
            "vat_number": {
              "type": "string",
              "pattern": "^[A-Z0-9]{1,14}$",
              "maxLength": 14,
              "minLength": 1,
              "description": "VAT number without country prefix or punctuation."
            },
            "country_code": {
              "enum": [
                "AT",
                "BE",
                "BG",
                "CY",
                "CZ",
                "DE",
                "DK",
                "EE",
                "EL",
                "ES",
                "FI",
                "FR",
                "HR",
                "HU",
                "IE",
                "IT",
                "LT",
                "LU",
                "LV",
                "MT",
                "NL",
                "PL",
                "PT",
                "RO",
                "SE",
                "SI",
                "SK",
                "XI"
              ],
              "type": "string",
              "maxLength": 2,
              "minLength": 1,
              "description": "VIES member-state code; Greece EL, Northern Ireland XI."
            },
            "request_date": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1,
              "description": "Time reported by VIES",
              "$comment": "{\"apiosk_output_aliases_v1\":[\"check_date\"]}"
            }
          }
        },
        "notice": {
          "type": "string",
          "maxLength": 2000,
          "minLength": 1,
          "description": "Source limitations"
        },
        "coverage": {
          "type": "object",
          "required": [
            "complete",
            "scope"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "description": "Scope of the returned response"
            },
            "complete": {
              "type": "boolean"
            }
          }
        },
        "source_url": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1,
          "description": "Exact upstream request URL"
        }
      },
      "description": "Validate a VAT number using VIES"
    }
  }
