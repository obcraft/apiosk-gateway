      "api_slug": "gleif",
      "name": "GLEIF",
      "description": "Search the global GLEIF Legal Entity Identifier dataset for a company or other legal entity by name, optionally narrowed by country or entity status. Returns matching LEIs and canonical legal-entity records rather than scraped firmographic guesses.",
      "source_url": "https://www.gleif.org/en/lei-data/gleif-api",
      "method": "GET",
      "path": "/lei-records",
      "listing_type": "api",
      "list_atomic": 47259,
      "fixed_params": {
        "page[size]": 10
      },
      "preconditions": {},
      "pagination": {},
      "freshness_seconds": 3600,
      "contract": {
        "capability_slug": "company.legal-entity-search",
        "cardinality": "many",
        "identifies": "company.registration.lei",
        "input_map": {
          "company.name": {
            "in": "query",
            "name": "filter[entity.legalName]"
          },
          "company.search.country_code": {
            "in": "query",
            "name": "filter[entity.legalAddress.country]"
          }
        },
        "max_fan_out": 1,
        "output_map": {
          "base": "$.data[*]",
          "produces": {
            "company.gleif_record": {
              "path": "$"
            },
            "company.name": {
              "path": "$.attributes.entity.legalName.name"
            },
            "company.registration.lei": {
              "path": "$.id"
            }
          }
        },
        "requires": [
          {
            "fact_type": "company.name",
            "optional": false,
