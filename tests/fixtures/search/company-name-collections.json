                  "name": "Example Company"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "dc655508-e529-4c2f-905e-1b6d69b80e4c",
      "endpoint_id": "b050c654-284a-49e8-a7ca-0bfca565816e",
      "api_slug": "kvk-dutch-business-register",
      "name": "KVK Business Register",
      "description": "Retrieve the official registration record for a company from a national business register: statutory and trade names, registered activities (SBI codes), employee counts, legal form, registration date, addresses, website and branches. The authoritative record as filed with the chamber of commerce, as opposed to a scraped or inferred firmographic profile. Dutch Handelsregister (KVK) coverage: basisp",
      "source_url": "https://developers.kvk.nl/nl/documentation",
      "method": "GET",
      "path": "/api/v1/basisprofielen",
      "listing_type": "api",
      "list_atomic": 66162,
      "fixed_params": {},
      "preconditions": {},
      "pagination": {},
      "freshness_seconds": null,
      "contract": {
        "capability_slug": "company.registry-profile",
        "cardinality": "one",
        "identifies": "company_registry.kvknummer",
        "input_map": {
          "company_registry.kvknummer": {
            "in": "path_append",
            "name": "kvkNummer"
          }
        },
        "max_fan_out": 1,
        "output_map": {
          "base": "$",
          "produces": {
            "company.name": {
              "path": "$.naam"
            },
            "company.nl.main_establishment_addresses": {
              "path": "$._embedded.hoofdvestiging.adressen"
            },
            "company.nl.main_establishment_id": {
              "path": "$._embedded.hoofdvestiging.vestigingsnummer"
            },
            "company.nl.registered_name": {
              "path": "$.statutaireNaam"
            },
            "company.nl.rsin": {
              "path": "$._embedded.eigenaar.rsin"
            },
            "company.nl.sbi_activities": {
              "path": "$.sbiActiviteiten"
            },
            "company.profile": {
              "fields": {
                "legal_name": {
                  "path": "$.statutaireNaam"
                },
                "sbi_codes": {
                  "collect": true,
                  "path": "$.sbiActiviteiten[*].sbiCode"
                },
                "trade_names": {
                  "collect": true,
                  "path": "$.handelsnamen[*].naam"
                }
              }
            },
            "company_registry.kvknummer": {
              "path": "$.kvkNummer"
            },
            "web.company_website_query": {
              "adapter": "record.website-query",
              "key": "{\"name\":\"/naam\",\"identifier\":\"/kvkNummer\",\"registry\":\"KVK\",\"pattern\":\"^[0-9]{8}$\"}"
            }
          }
        },
        "requires": [
          {
            "fact_type": "company_registry.kvknummer",
            "optional": false,
            "subject_role": "subject"
          }
        ],
        "version": 9
      },
      "sample_payload": {
        "naam": "Example Company",
        "statutaireNaam": "Example Company",
        "kvkNummer": "12345678",
        "sbiActiviteiten": [
          {
            "sbiCode": "62010"
          }
        ],
        "handelsnamen": [
          {
            "naam": "Example Company"
          }
        ],
        "_embedded": {
          "eigenaar": {
            "rsin": "123456789"
          },
          "hoofdvestiging": {
            "adressen": [],
            "vestigingsnummer": "123456789012"
          }
        }
      }
    }
